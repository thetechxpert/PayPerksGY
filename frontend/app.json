{
  "expo": {
    "name": "PayPerks GY",
    "slug": "payperks-gy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "payperksgy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.payperksgy.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan QR codes to redeem offers",
        "NSPhotoLibraryUsageDescription": "Upload receipt photos for verification"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#00A86B"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.payperksgy.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f0f1a"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PayPerks GY to scan QR codes"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Select receipt photos for verification"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
